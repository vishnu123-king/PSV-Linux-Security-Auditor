[Unit]
Description=PSV Linux Security Auditor API Service
After=network.target postgresql.service rabbitmq-server.service
Documentation=https://github.com/psv-auditor/psv-linux-security-auditor

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
EnvironmentFile={{INSTALL_DIR}}/.env
ExecStart={{INSTALL_DIR}}/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

# Systemd Sandboxing & Hardening Directives
ProtectSystem=full
ProtectHome={{PROTECT_HOME}}
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{INSTALL_DIR}} /var/log/psv /var/lib/psv /etc/psv /tmp

[Install]
WantedBy=multi-user.target
