[Unit]
Description=PSV Linux Security Auditor Assessment Worker
After=network.target postgresql.service rabbitmq-server.service psv-api.service
Documentation=https://github.com/psv-auditor/psv-linux-security-auditor

[Service]
Type=simple
User=psv
Group=psv
WorkingDirectory=/opt/psv-linux-security-auditor
EnvironmentFile=/opt/psv-linux-security-auditor/.env
ExecStart=/opt/psv-linux-security-auditor/.venv/bin/python -m backend.app.workers.assessment_worker
Restart=always
RestartSec=10s
LimitNOFILE=65535

# Systemd Hardening (Requirement #56)
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/psv-linux-security-auditor/reports /opt/psv-linux-security-auditor/logs
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
