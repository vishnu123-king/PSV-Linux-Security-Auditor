# PSV Linux Security Auditor - Environment Configuration
APP_NAME="PSV Linux Security Auditor"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Secret Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
JWT_SECRET="replace-this-with-a-secure-jwt-signing-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Primary: PostgreSQL (production) e.g., postgresql+asyncpg://psv_user:psv_pass@localhost:5432/psv_auditor
# Fallback / Dev: SQLite async e.g., sqlite+aiosqlite:///./psv_auditor.db
DATABASE_URL="sqlite+aiosqlite:///./psv_auditor.db"
# DATABASE_URL="postgresql+asyncpg://psv:psv_secure_pass@localhost:5432/psv_auditor"

# Message Broker Configuration (RabbitMQ)
# Primary: amqp://guest:guest@localhost:5672/
# Dev fallback: "memory://" (processes asynchronously in-process if RabbitMQ is not running)
RABBITMQ_URL="memory://"
# RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# Worker & Assessment Concurrency
MAX_CONCURRENT_ASSESSMENTS=4
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=30
SSH_MAX_OUTPUT_BYTES=1048576

# Security & CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
LOG_LEVEL="INFO"

# Default Admin Seed Credentials (for initial deployment)
INITIAL_ADMIN_EMAIL="admin@psv.local"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
